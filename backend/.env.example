# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (Port: 5432, Database: ontime_db)
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ontime_db

# Or full connection URL (Note: if password contains special symbols like @ or #, use DB_PASSWORD above instead)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ontime_db

# JWT Secret for Session Authentication
JWT_SECRET=ontime_college_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# Payment Gateway Configuration (Razorpay / Sandbox)
PAYMENT_MODE=test
PAYMENT_KEY_ID=rzp_test_college_ontime_key_1234
PAYMENT_KEY_SECRET=rzp_test_secret_college_ontime_9876

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Firebase Firestore Configuration (Google Cloud Firestore / Firebase Admin SDK)
# Option 1: Direct Service Account credentials (recommended for Render, Vercel, Railway, etc.)
FIREBASE_PROJECT_ID=ontime-college-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ontime-college-project.iam.gserviceaccount.com
# Wrap private key in quotes and preserve \n literals
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to serviceAccountKey.json file (relative to backend or absolute)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 3: Full JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
