# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication
JWT_SECRET=ontime_college_super_secure_jwt_secret_key_2026_dev
JWT_EXPIRES_IN=7d

# Payment Gateway Configuration (Razorpay / Sandbox)
PAYMENT_MODE=test
PAYMENT_KEY_ID=rzp_test_college_ontime_key_1234
PAYMENT_KEY_SECRET=rzp_test_secret_college_ontime_9876

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Firebase Firestore Configuration (Google Cloud Firestore / Firebase Admin SDK)
#
# OPTION 1 (Recommended for local development):
# Download your service account private key JSON file from the Firebase Console:
# Project Settings (gear icon) -> Service accounts -> "Generate new private key".
# Save or rename the file to 'serviceAccountKey.json' and place it directly inside the 'backend' folder:
# Path: backend/serviceAccountKey.json
# (The backend will automatically detect it, or you can specify the relative path below):
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=OnTime

# OPTION 2 (Recommended for Render / Cloud hosting where files cannot be stored):
# FIREBASE_PROJECT_ID=OnTime
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@ontime.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPTION 3 (Full JSON string):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
